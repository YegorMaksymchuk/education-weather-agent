# Токен бота від @BotFather (Telegram)
TELEGRAM_BOT_TOKEN=

# Ключ API OpenAI (для моделі gpt-4o-mini)
OPENAI_API_KEY=

# Облікові дані Google Calendar (для інтеграції через LangChain Google Calendar Toolkit)
# Шлях до client secrets (credentials.json), виданого Google Cloud Console
# GOOGLE_CALENDAR_CREDENTIALS_PATH=./credentials.json
# Шлях до token.json (створюється автоматично при першій авторизації)
# GOOGLE_CALENDAR_TOKEN_PATH=./token.json

# Модель за замовчуванням (опційно)
# DEFAULT_MODEL=gpt-4o-mini

# Версія системного промпта: 1, 2 або 3 (3 — з історичною погодою) (опційно)
# PROMPT_VERSION=2

# ChromaDB для історичної погоди (RAG) (опційно)
# CHROMA_PERSIST_DIR=chroma_langchain_db
# CHROMA_COLLECTION_NAME=historical_weather
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Виключити з httpx-трейсів запити до Telegram (у URL є секрет бота — інакше токен потрапляє в Grafana/логи)
# Див. opentelemetry-instrumentation-httpx: OTEL_PYTHON_HTTPX_EXCLUDED_URLS
# OTEL_PYTHON_HTTPX_EXCLUDED_URLS="api\.telegram\.org"

# ─── Observability (OpenLIT / OpenTelemetry) ───
# Endpoint OTLP-колектора. У Docker Compose для сервісу weather-agent вже задано автоматично.
# Для локальної розробки зі стеком observability: http://localhost:4318 (після make observability-up)
# Залиште порожнім або не задавайте — експорт телеметрії вимкнено (без відправки трейсів).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Назва сервісу в трейсах (відображається в Grafana)
# OTEL_SERVICE_NAME=weather-agent

# Середовище розгортання (development / staging / production)
# OTEL_DEPLOYMENT_ENVIRONMENT=development

# Чи записувати вміст промптів та відповідей LLM у трейси (OpenLIT: capture_message_content; true/false)
# Увага: у production може містити персональні дані користувачів!
# OPENLIT_TRACE_CONTENT=true
# Альтернатива (сумісність з іменами OTel GenAI): OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# Pytest: експорт OTLP під час тестів (щоб після прогону бачити трейси/метрики в Grafana).
# Потрібен запущений колектор, напр. make observability-up. Приклад:
# OTEL_TESTS_EXPORT=1 OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 pytest tests/
# Або: make test-with-otel-export
# Для повного GenAI-дашборду (реальний OpenAI): OPENAI_API_KEY=... make test-with-otel-llm
